# Docker Compose settings. Copy to .env (or run `make init`, which generates random passwords once).
# Never commit .env.
#
# Passwords are applied to MySQL only on first volume init. After that, changing
# these values alone will NOT update MySQL — run `make db-password-sync` instead.
# Local compose (growth-planet-dev) and prod compose use separate volumes so
# `make preview` cannot silently swap which password the data directory expects.

MYSQL_DATABASE=growth_planet
MYSQL_USER=growth_planet
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host ports (127.0.0.1 only for MySQL)
HTTP_PORT=8088
MYSQL_HOST_PORT=33061

# Base image for the PHP container; override if Docker Hub is unreachable and you have a mirror.
PHP_BASE=php:8.4-fpm-bookworm
