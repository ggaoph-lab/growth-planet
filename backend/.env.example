APP_NAME="成长星球"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In Docker these are injected by compose.yaml from the root .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=growth_planet
DB_USERNAME=growth_planet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts whose browser requests receive stateful (cookie) Sanctum auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8088,localhost:5173,127.0.0.1:8088,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional Redis (cache/queue/rate limiting). Leave unset to use the database drivers.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Third-party keys are only read by the backend. Leave empty to disable the integration.
TMDB_API_KEY=