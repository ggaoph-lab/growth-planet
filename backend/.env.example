APP_NAME="成长星球"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

# 8 is plenty for a rate-limited family login and much faster on NAS CPUs than Laravel's default 12.
# Successful logins rehash older cost-10/12 hashes down in the background after the response.
BCRYPT_ROUNDS=8

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In Docker these are injected by compose.yaml from the root .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=growth_planet
DB_USERNAME=growth_planet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=growth-planet-session
# Set to true in production (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts whose browser requests receive stateful (cookie) Sanctum auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8088,localhost:5173,127.0.0.1:8088,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional Redis (cache/queue/rate limiting). Leave unset to use the database drivers.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Third-party keys are only read by the backend. Leave empty to disable the integration.
TMDB_API_KEY=

# Homework text → structured tasks. auto prefers Gemini (good for Singapore), then Qwen.
# HOMEWORK_LLM_PROVIDER=auto|gemini|qwen|rules
HOMEWORK_LLM_PROVIDER=auto

# Google Gemini (AI Studio / Gemini API). Recommended on Oracle Singapore hosts.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.1-flash-lite

# 通义千问（阿里云百炼 DashScope）。Gemini 失败或未配置时可用。
# 控制台建议开启「免费额度用完即停」。
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-turbo

# Kid read-aloud: with GEMINI_API_KEY, prefer free Gemini 2.5 Flash Preview TTS;
# otherwise Edge neural (no key). DashScope is a further fallback.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_VOICE_EN=Kore
# TTS_PREFER_GEMINI=true
# TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# TTS_EDGE_VOICE_EN=en-US-JennyNeural
