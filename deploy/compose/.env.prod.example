# Production environment for compose.prod.yaml
# Copy to deploy/compose/.env.prod and fill in secrets:  chmod 600 deploy/compose/.env.prod
# Never commit .env.prod.

# --- Application ---
APP_NAME=成长星球
APP_ENV=production
APP_DEBUG=false
# Generate with: openssl rand -base64 32
# Then set as: APP_KEY=base64:<output>
APP_KEY=
# Public URL used for cookies / redirects (include https:// when TLS is enabled)
APP_URL=https://your.domain.example
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning
# Faster parent-password verify on NAS; successful logins rehash older cost-10/12 hashes after respond.
BCRYPT_ROUNDS=8

# --- Database (MySQL container; not exposed on the host) ---
MYSQL_DATABASE=growth_planet
MYSQL_USER=growth_planet
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Session / Sanctum (SPA same-origin) ---
# Required when APP_NAME is non-Latin (slug would become "-session").
SESSION_COOKIE=growth-planet-session
# Set true when serving over HTTPS (recommended).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Comma-separated hosts the browser will call (no scheme, include :port when not 80/443).
# Include every entry host you use (LAN IP, Tailscale IP, public domain / port-forward hostname).
SANCTUM_STATEFUL_DOMAINS=gk.hzwd.asia:8088,192.168.66.45:8088,100.88.116.20:8088

# --- Cache / queue (database drivers keep the footprint small on a single VM) ---
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# --- Optional integrations (backend only; leave empty to disable) ---
TMDB_API_KEY=
HOMEWORK_LLM_PROVIDER=auto
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-turbo

# Kid TTS uses Edge neural voice only (warmed by english:prepare-day). Gemini TTS is not used.
# TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# TTS_EDGE_VOICE_EN=en-US-JennyNeural
# Optional OpenAI-compatible relay for ChatGPT/Claude chat (family UI can override):
# OPENAI_BASE_URL=https://ai.example.com/v1
# OPENAI_API_KEY=


# --- Host ports ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backup encryption passphrase (used by deploy/scripts/backup.sh) ---
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Prebuilt images (GHCR; updated by GitHub Actions on main) ---
# Rolling: :main or :latest — pin for rollback: :sha-<short> or :1.2.3 after a git tag v1.2.3
PHP_IMAGE=ghcr.io/ggaoph-lab/growth-planet-php:main
NGINX_IMAGE=ghcr.io/ggaoph-lab/growth-planet-nginx:main

# --- Local build only (compose.build.yaml / LOCAL_BUILD=1); ignore when pulling GHCR ---
PHP_BASE=php:8.4-fpm-bookworm
NODE_BASE=node:22-bookworm
NGINX_BASE=nginx:1.27-alpine
